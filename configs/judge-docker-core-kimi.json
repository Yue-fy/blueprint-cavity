{
  "job_name": "judge-docker-core-kimi",
  "jobs_dir": "runs/judge-docker",
  "n_concurrent_trials": 1,
  "environment": {
    "type": "docker",
    "delete": true,
    "kwargs": {}
  },
  "verifier": {
    "override_timeout_sec": 60
  },
  "agents": [
    {
      "name": "opencode",
      "model_name": "verda/kimi-k3-1-pro",
      "skip_model_parsing": true,
      "base_url": "https://inference.verda.com/v1",
      "model_api_key_name": "VERDA_INFERENCE_API_KEY",
      "model_api_format": "openai_chat_completions",
      "kwargs": {
        "version": "1.19.5",
        "opencode_config": {
          "provider": {
            "verda": {
              "npm": "@ai-sdk/openai-compatible",
              "name": "Verda",
              "models": {
                "kimi-k3-1-pro": {
                  "name": "kimi-k3-1-pro",
                  "limit": {
                    "context": 128000,
                    "output": 8192
                  }
                }
              }
            }
          },
          "snapshot": false
        },
        "skip_install": true
      }
    }
  ],
